# ========================================================
# Delta Exchange Algorithmic Trading Platform Configuration
# ========================================================

# Exchange Target: "india" (for api.india.delta.exchange) or "global" (for api.delta.exchange)
DELTA_EXCHANGE_TYPE=india

# Delta Exchange API Credentials (obtain from Delta Exchange -> Settings -> API Keys)
DELTA_API_KEY=
DELTA_API_SECRET=

# Telegram Mobile Notifications (Create bot via @BotFather, get Chat ID via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk Management Guardrails
DEFAULT_MAX_DAILY_LOSS_USD=100.0
DEFAULT_MAX_LEVERAGE=10
DEFAULT_MAX_POSITION_SIZE_USD=500.0

# Database & Security
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
SECRET_KEY=change_this_to_a_secure_random_string_on_your_vps
